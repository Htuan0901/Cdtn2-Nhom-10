# Sao chép file này thành ".env" (cùng thư mục với app.py) rồi điền API Key. KHÔNG đưa file .env lên GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Tùy chọn: tỷ giá quy đổi lương USD → VND khi chuẩn hóa dữ liệu tuyển dụng Việt Nam
USD_TO_VND=25000

# Chỉ dùng khi đưa app lên web (Streamlit Cloud: đặt trong ô Secrets, không cần file .env)
# APP_PUBLIC=1 ẩn lịch sử hoạt động / huấn luyện / nhật ký lỗi dùng chung ở trang Thông tin hệ thống
# và bật giới hạn câu hỏi Gemini mỗi phiên (mặc định 20 câu khi APP_PUBLIC=1).
APP_PUBLIC=0
# Số câu hỏi Gemini tối đa mỗi phiên khi dùng key của nhóm. 0 = không giới hạn. Để trống = mặc định.
GEMINI_MAX_QUESTIONS=
